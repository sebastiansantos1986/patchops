# Copy to .env (never commit .env) and restart `npm run dev`.
# Setup steps: docs/fleet-posture.md

# Microsoft Intune — Entra app registration with Graph application permission
# DeviceManagementManagedDevices.Read.All (admin consent granted)
INTUNE_TENANT_ID=
INTUNE_CLIENT_ID=
INTUNE_CLIENT_SECRET=
# Optional: exact installed-KB lists from the PatchOps Remediation script
# (needs DeviceManagementConfiguration.Read.All). See docs/fleet-posture.md
# INTUNE_KB_SCRIPT_ID=

# Jamf Pro — API client whose role has "Read Computers"
JAMF_URL=https://yourcompany.jamfcloud.com
JAMF_CLIENT_ID=
JAMF_CLIENT_SECRET=

# CrowdStrike Falcon: API client scopes
#   Hosts: Read            (required)  devices, sensor health
#   Assets: Read           (optional)  installed applications (Falcon Discover / Exposure Management)
#   Vulnerabilities: Read  (optional)  open CVEs and KB remediations (Falcon Spotlight)
# The cloud (US-1, US-2, EU-1, GovCloud) is detected automatically; set
# CROWDSTRIKE_CLOUD=us-2 / eu-1 / us-gov-1 only if detection fails.
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
# CROWDSTRIKE_CLOUD=
# CROWDSTRIKE_INCLUDE_SERVERS=false

# Public vulnerability feeds (Apple SOFA, Microsoft MSRC, CISA KEV): on by default,
# no keys needed. Set to false if the server has no internet access.
# POSTURE_CVE_FEEDS=true
# POSTURE_MSRC_MONTHS=12

# Saved data (private, git-ignored folder; no secrets stored)
# POSTURE_CACHE=true
# POSTURE_CACHE_DIR=.patchops-cache
# CROWDSTRIKE_FULL_SYNC_HOURS=24

# Optional tuning
# POSTURE_SYNC_MINUTES=30
# POSTURE_STALE_DAYS=14
# POSTURE_LATEST_MACOS=26.1
# POSTURE_MIN_MACOS=
# POSTURE_MIN_WINDOWS_BUILD=22000
# INTUNE_INCLUDE_APPS=true
