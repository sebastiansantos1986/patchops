{
  "name": "patchops",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-platform patch orchestration proof of concept",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "api": "node services/control-plane/src/server.mjs",
    "simulate": "node poc-scaffold/agent/simulator.js",
    "notification:macos": "bash tools/notification-lab/macos-popup.sh",
